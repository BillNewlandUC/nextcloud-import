# Copy to config.env. Every value is optional — anything left unset
# falls back to a default or is derived from the Nextcloud stack.
#
# Precedence, highest first:
#   1. environment variables set on the command line
#   2. this file
#   3. the Nextcloud stack's own .env (via NC_STACK_DIR)
#   4. built-in defaults

# Path to the Nextcloud stack. If set, NC_DATA and the container name
# are taken from it, so there is one source of truth for the data
# directory rather than two that can drift apart.
NC_STACK_DIR=../nextcloud-stack

# Only needed if NC_STACK_DIR is unset or you want to override.
#NC_CONTAINER=nextcloud-app-1
#NC_DATA=/srv/nextcloud/data

# MUST be on the same filesystem as NC_DATA: install uses mv, which is
# then instant. Across filesystems it becomes a full copy — twice the
# disk and hours longer. `check` refuses to continue if they differ.
STAGING=/srv/nextcloud/import-staging

# www-data inside the official Nextcloud image.
NC_UID=33
NC_GID=33

# Microsoft throttles hard; unthrottled runs stall out.
RCLONE_FLAGS=--transfers 4 --checkers 8 --tpslimit 10

# Your own Azure app registration. Optional, but rclone's built-in
# client ID is rate-limited across every rclone user in the world.
#OD_CLIENT_ID=
#OD_CLIENT_SECRET=
